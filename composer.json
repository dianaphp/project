{
    "name": "dianaphp/project",
    "description": "a brand new bin/diana project",
    "keywords": [
        "diana",
        "framework",
        "php"
    ],
    "minimum-stability": "dev",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "diana": [
            "bin/diana"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php boot/serve.php"
        ]
    },
    "authors": [
        {
            "name": "Antonio Ianzano",
            "email": "ianzanoan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5.12",
        "dianaphp/framework": "dev-main",
        "dianaphp/router": "dev-main",
        "dianaphp/rendering": "dev-main",
        "dianaphp/database": "dev-main",
        "illuminate/database": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": false
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
